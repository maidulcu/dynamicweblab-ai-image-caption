# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=False

# Anthropic Claude API (optional - for advanced captions)
ANTHROPIC_API_KEY=your_api_key_here

# Model Configuration
# BLIP (fallback) model
CAPTION_MODEL=Salesforce/blip-image-captioning-large

# Moondream Configuration (recommended - better quality)
# Enable Moondream (tries cloud if API key set, otherwise local GPU)
USE_MOONDREAM=True

# Moondream Cloud API (optional - $5 free/month, then $0.30-$2.50 per million tokens)
# Get API key at: https://console.moondream.ai/
# If set, uses cloud API. If not set, uses local GPU model.
MOONDREAM_API_KEY=

# Moondream Local Model Configuration (for GPU inference)
MOONDREAM_MODEL=vikhyatk/moondream2
MOONDREAM_REVISION=2025-06-21

# Claude API (optional - advanced captions, requires API key)
USE_CLAUDE_API=False

# SEO Configuration
DEFAULT_KEYWORDS=product,shop,buy,online,quality
MAX_ALT_TEXT_LENGTH=125

# Social Media Configuration
INSTAGRAM_MAX_LENGTH=2200
TWITTER_MAX_LENGTH=280
FACEBOOK_MAX_LENGTH=63206

# Rate Limiting (FREE SERVICE PROTECTION)
RATE_LIMIT_ENABLED=True
REQUESTS_PER_MINUTE=10
REQUESTS_PER_HOUR=100
REQUESTS_PER_DAY=500
IMAGES_PER_DAY=1000
BATCH_LIMIT=50

# Security
ADMIN_API_KEY=change_this_to_random_secure_key_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
TRUST_PROXY_HEADERS=False
